# ============================================
# CodeAlpha Cloud Computing Internship
# Environment Variables (.env.example)
# ============================================
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# ---- Task 1: Data Redundancy Removal System ----
TASK1_PORT=3001
TASK1_DB_PATH=./data/redundancy.db

# ---- Task 3: Cloud-Based Bus Pass System ----
TASK3_PORT=3003
TASK3_DB_PATH=./data/buspass.db
TASK3_JWT_SECRET=your-jwt-secret-change-me
TASK3_SESSION_SECRET=your-session-secret-change-me

# ---- Task 4: Chatbot ----
TASK4_PORT=3004
# Optional: For AI-powered responses (OpenAI API)
# If not set, the chatbot uses built-in retrieval-based responses
OPENAI_API_KEY=your-openai-api-key-here
